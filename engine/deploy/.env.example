# Copy to deploy/.env on the server and fill in. Never commit the real file.
ENGINE_SECRET=change-me-to-a-long-random-string-at-least-32-chars
POSTGRES_PASSWORD=change-me
# Public hostname (DNS A record -> server IP). Traefik gets the HTTPS certificate.
ENGINE_HOST=engine.dulcy.io
# Paid provider calls stay OFF until this is "false" (Alex approves per stage).
DRY_RUN=true
# Optional: Slack incoming webhook for error alerts.
SLACK_WEBHOOK_URL=
# Decisions loop (Slack ✅/❌ ↔ Airtable Decisions). Bot token from the "Dulcy Agents" Slack app.
SLACK_BOT_TOKEN=
# SLACK_DECISIONS_CHANNEL=C0B581HNSMR   (Alex's pick, 2026-11-24)
# SLACK_APPROVERS=U070Z26377C,U0ADSEJ9SDR   (Alex, Josh)
# Sending approved replies is a dry run until decision.send_reply is added to LIVE_STAGES.
# MillionVerifier API key (add it yourself on the server; never paste it in chat).
MILLIONVERIFIER_API_KEY=
# Google read-only access: the service-account key goes in deploy/secrets/google-sa.json
# (deploy.sh moves deploy/google-sa.json there). The engine reads sheets as this user.
GOOGLE_IMPERSONATE_USER=scale@dulcy.io
# EmailBison: one key per workspace, EMAILBISON_KEY_<WORKSPACE> (type it on the server; never in chat).
# EMAILBISON_KEY_DULCY=
# Stages allowed to make real calls while DRY_RUN stays true for the rest (comma list), e.g. campaign.build
LIVE_STAGES=
# Bounce check timer (0 = off) and which workspaces it checks (each needs EMAILBISON_KEY_<WS>).
BOUNCE_CHECK_EVERY_MIN=0
# "all" = every workspace the BOUNCE_CHECK_KEY key can reach (the Dulcy key reaches all 35), or a comma list of key names.
BOUNCE_CHECK_WORKSPACES=
BOUNCE_CHECK_KEY=dulcy
# Credit caps (provider units per job / per 24h, per provider).
CAP_PER_JOB=100000
CAP_PER_DAY=100000

# DiscoLike (lead-list company search): type it on the server; never in chat.
# DISCOLIKE_API_KEY=
# Google scope the engine asks for; must match domain-wide delegation (read + write since 2026-11-18).
# GOOGLE_SCOPE=https://www.googleapis.com/auth/spreadsheets
# OpenAI: ONE call per lead list to build its profile (who we want, why, who we don't). Type the key on the server; never in chat.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.6-luna

# Echo (inbox agent, draft mode). Off until SEAN_EVERY_MIN is set; Claude is only called when sean.draft is in LIVE_STAGES.
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5
SEAN_EVERY_MIN=0
# SEAN_DAYS=14
# SEAN_MAX_PER_RUN=20
# Automatic sends where a client's Reply Agent settings ask for them (Default Mode Autopilot / Auto High Confidence, OOO Auto Send). off = every reply waits for a person.
# SEAN_AUTO_SEND=on
# Client calendars come from the calendar service (dulcy-calendar on n8n's network); read-only token from
# /opt/dulcy-calendar/data/private/config.json (readerToken). Without it Echo uses each client's saved booking link.
CALENDAR_READER_TOKEN=
# Optional (HQ → client → AI replier → "Get calendar link"): a calendar-service token allowed to call
# /calendar/admin/request-invite (the service's inviter token is enough). Empty = the button stays off.
CALENDAR_ADMIN_TOKEN=
# CALENDAR_URL=http://dulcy-calendar:8789
# The engine sends approved replies for every workspace. Turn on only after the n8n sender is switched off
# (automations/n8n-fix.mjs FIX=replier-off), and add reply.send to LIVE_STAGES.
REPLY_SENDER=off

# Ledger (accountant, read only). Xero app from developer.xero.com (Web app, redirect http://localhost:8765/callback).
# After deploy, log in once: docker compose exec engine node dist/src/cli.js xero-connect
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
# LEDGER=on                  # Saturday report (LEDGER_REPORT_HOUR, default 9 AM ET) to LEDGER_CHANNEL (default Alex's DM)
# LEDGER_CHECK_EVERY_MIN=5   # purchase yes/no in LEDGER_CHECK_CHANNEL (default the decisions channel)
# Add ledger.report,ledger.check to LIVE_STAGES to post (otherwise dry run).
# Mercury Read Only token (Ledger: live balances + reconciliation prep). Paste it with the secret-token: prefix.
MERCURY_TOKEN=
# LEDGER_PREP_FROM=2026-11-01   # first Mercury date Ledger prepares
# LEDGER_PREP_HOUR=7            # daily prep time (ET); add ledger.prep to LIVE_STAGES to write to Xero
# LEDGER_PREP_WRITE=off        # off = checker only (default). on = Ledger also creates Xero entries (not used: duplicates risk)

# Atlas (client health, Mondays), Cole (sales-call reviews from Fathom), Sienna (content ideas Mon, scripts Thu).
# ATLAS=on            # + atlas.health in LIVE_STAGES
# COLE=on             # + cole.review in LIVE_STAGES; needs FATHOM_API_KEY (Fathom → Settings → API Access)
FATHOM_API_KEY=
# HQ Sales (read only): Close → Settings → API Keys. Without it HQ Sales says "Connect Close".
CLOSE_API_KEY=
# SIENNA=on           # + sienna.ideas,sienna.prep in LIVE_STAGES

# Campaign creation (Atlas plans the next campaign; you approve plan + first 100 in Slack).
# ATLAS_CAMPAIGNS=on            # + atlas.plan,campaign.pipeline,campaign.plan_approved,campaign.contacts_approved,scribe.copy,campaign.copy_approved in LIVE_STAGES
# CAMPAIGN_PIPELINE_EVERY_MIN=5 # how often it checks triggers and moves plans on
# CAMPAIGN_PLANS_MAX_OPEN=2     # plans waiting at once (each spends ~$1 on a 100-company sample)

# Riley (systems repair): logs failed/stuck engine jobs (+ n8n errors) to System Issues every 15 min.
# RILEY=on                      # + riley.collect,riley.apply in LIVE_STAGES
# RILEY_EVERY_MIN=15
# N8N_API_KEY=                  # optional: n8n Settings → n8n API
# N8N_BASE_URL=http://localhost:5678

# Dulcy HQ (private web app at https://HQ_HOST; DNS A record "hq" -> the server IP).
HQ_HOST=hq.dulcy.io
# Session cookie key: 32+ random characters (openssl rand -base64 48). HQ stays off without it.
HQ_SESSION_SECRET=
# Optional "Sign in with Google" (Google Cloud → OAuth client, Web application; redirect URI
# https://hq.dulcy.io/hq/api/auth/google/callback). Only emails that already have an HQ login get in.
HQ_GOOGLE_CLIENT_ID=
HQ_GOOGLE_CLIENT_SECRET=
# Chat cost guard: tool rounds and output tokens per answer.
# HQ_CHAT_MAX_ROUNDS=4
# HQ_CHAT_MAX_TOKENS=4000
# HQ phone notifications (Web Push). Nothing to set: the key pair is made on first start and kept in Postgres.
# Optional: your own pair (npx web-push generate-vapid-keys), a contact for the push services, or off.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=https://hq.dulcy.io
# HQ_PUSH=on
# Reports and decisions in Slack too (on) or in HQ only (off). Urgent alerts always go to Slack.
SLACK_REPORTS=on
SLACK_DECISIONS=on
# LeadMagic: single (default) = parallel single Email Finder calls; bulk = LeadMagic's bulk queue (slow, ~19 rows/min seen).
# LEADMAGIC_MODE=single
# LEADMAGIC_CONCURRENCY=40
# LEADMAGIC_PER_MIN=250
# Sienna reads Agency Ignition (Alex's Discord) for video ideas: a bot with Read Message History + Message Content intent.
# DISCORD_BOT_TOKEN=
# Optional: only these channels (default: every text channel the bot can see)
# SIENNA_DISCORD_CHANNELS=123456789012345678,234567890123456789
