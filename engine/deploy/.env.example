# Copy to deploy/.env on the server and fill in. Never commit the real file.
ENGINE_SECRET=change-me-to-a-long-random-string-at-least-32-chars
POSTGRES_PASSWORD=change-me
# Public hostname (DNS A record -> server IP). Traefik gets the HTTPS certificate.
ENGINE_HOST=engine.dulcy.io
# Paid provider calls stay OFF until this is "false" (Alex approves per stage).
DRY_RUN=true
# Optional: Slack incoming webhook for error alerts.
SLACK_WEBHOOK_URL=
# Decisions loop (Slack ✅/❌ ↔ Airtable Decisions). Bot token from the "Dulcy Agents" Slack app.
SLACK_BOT_TOKEN=
# SLACK_DECISIONS_CHANNEL=C0B581HNSMR   (Alex's pick, 2026-11-24)
# SLACK_APPROVERS=U070Z26377C,U0ADSEJ9SDR   (Alex, Josh)
# Sending approved replies is a dry run until decision.send_reply is added to LIVE_STAGES.
# MillionVerifier API key (add it yourself on the server; never paste it in chat).
MILLIONVERIFIER_API_KEY=
# Google read-only access: the service-account key goes in deploy/secrets/google-sa.json
# (deploy.sh moves deploy/google-sa.json there). The engine reads sheets as this user.
GOOGLE_IMPERSONATE_USER=scale@dulcy.io
# EmailBison: one key per workspace, EMAILBISON_KEY_<WORKSPACE> (type it on the server; never in chat).
# EMAILBISON_KEY_DULCY=
# Stages allowed to make real calls while DRY_RUN stays true for the rest (comma list), e.g. campaign.build
LIVE_STAGES=
# Bounce check timer (0 = off) and which workspaces it checks (each needs EMAILBISON_KEY_<WS>).
BOUNCE_CHECK_EVERY_MIN=0
# "all" = every workspace the BOUNCE_CHECK_KEY key can reach (the Dulcy key reaches all 35), or a comma list of key names.
BOUNCE_CHECK_WORKSPACES=
BOUNCE_CHECK_KEY=dulcy
# Credit caps (provider units per job / per 24h, per provider).
CAP_PER_JOB=100000
CAP_PER_DAY=100000

# DiscoLike (lead-list company search): type it on the server; never in chat.
# DISCOLIKE_API_KEY=
# Google scope the engine asks for; must match domain-wide delegation (read + write since 2026-11-18).
# GOOGLE_SCOPE=https://www.googleapis.com/auth/spreadsheets
# OpenAI: ONE call per lead list to build its profile (who we want, why, who we don't). Type the key on the server; never in chat.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.6-luna

# Sean (inbox agent, draft mode). Off until SEAN_EVERY_MIN is set; Claude is only called when sean.draft is in LIVE_STAGES.
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5
SEAN_EVERY_MIN=0
# SEAN_DAYS=14
# SEAN_MAX_PER_RUN=20
# Client calendars come from the calendar service (dulcy-calendar on n8n's network); read-only token from
# /opt/dulcy-calendar/data/private/config.json (readerToken). Without it Sean uses each client's saved booking link.
CALENDAR_READER_TOKEN=
# CALENDAR_URL=http://dulcy-calendar:8789
# The engine sends approved replies for every workspace. Turn on only after the n8n sender is switched off
# (automations/n8n-fix.mjs FIX=replier-off), and add reply.send to LIVE_STAGES.
REPLY_SENDER=off

# Ledger (accountant, read only). Xero app from developer.xero.com (Web app, redirect http://localhost:8765/callback).
# After deploy, log in once: docker compose exec engine node dist/src/cli.js xero-connect
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
# LEDGER=on                  # Saturday report (LEDGER_REPORT_HOUR, default 9 AM ET) to LEDGER_CHANNEL (default Alex's DM)
# LEDGER_CHECK_EVERY_MIN=5   # purchase yes/no in LEDGER_CHECK_CHANNEL (default the decisions channel)
# Add ledger.report,ledger.check to LIVE_STAGES to post (otherwise dry run).
# Mercury Read Only token (Ledger: live balances + reconciliation prep). Paste it with the secret-token: prefix.
MERCURY_TOKEN=
# LEDGER_PREP_FROM=2026-11-01   # first Mercury date Ledger prepares
# LEDGER_PREP_HOUR=7            # daily prep time (ET); add ledger.prep to LIVE_STAGES to write to Xero
# LEDGER_PREP_WRITE=off        # off = checker only (default). on = Ledger also creates Xero entries (not used: duplicates risk)
