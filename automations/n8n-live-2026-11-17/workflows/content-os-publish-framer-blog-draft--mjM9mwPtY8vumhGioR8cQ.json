  {
   "parameters": {
    "jsCode": "const rec=$input.first().json;const f=rec.fields??{};const pick=v=>typeof v==='object'&&v?v.name??v.value??String(v):String(v??'');const platform=pick(f.Platform).trim();const outputType=pick(f['Output Type']).trim();const approval=pick(f['Approval Status']).trim();if(platform.toLowerCase()!=='framer')throw new Error('This action only supports Framer distribution items.');if(!/blog/i.test(outputType))throw new Error('This distribution item is not a Framer Blog draft.');if(approval.toLowerCase()!=='approved')throw new Error('Approve the blog draft before sending it to Framer.');const title=String(f['Draft Title']??'').trim();const content=String(f['Draft Body']??'').trim();if(!title||!content)throw new Error('Draft Title and Draft Body are required.');const plain=content.replace(/[#*_>`~\\[\\]()]/g,' ').replace(/\\s+/g,' ').trim();const description=plain.slice(0,240).replace(/\\s+\\S*$/,'').trim()||title;const slug=title.normalize('NFKD').replace(/[\\u0300-\\u036f]/g,'').toLowerCase().replace(/[^a-z0-9]+/g,'-').replace(/^-+|-+$/g,'').slice(0,90);return [{json:{distributionRecordId:rec.id,title,description,slug,content,date:new Date().toISOString(),author:'Alexander Woung',authorLink:'https://www.linkedin.com/in/alexanderwoung/'}}];"
   },
