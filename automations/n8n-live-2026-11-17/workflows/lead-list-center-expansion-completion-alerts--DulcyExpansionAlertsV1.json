  {
   "id": "7209597b-4c6b-4dfc-898b-2429039c0d67",
   "name": "Check and format completion",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    1100,
    0
   ],
   "parameters": {
    "mode": "runOnceForEachItem",
    "jsCode": "function prepareExpansionAlert(event, row, dryRun=false) {\n const f=row?.fields??{};\n const field=(id)=>f[id];\n const text=(v)=>typeof v==='string'?v:String(v??'');\n const escape=(v)=>text(v).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');\n const num=(v)=>v===undefined||v===null?0:Number(v);\n const reject=(reason)=>({ready:false,reason,dryRun,event});\n if(!event||!/^rec[A-Za-z0-9]+$/.test(event.recordId)||!/^\\d+$/.test(event.owner)||event.key!==`${event.kind}:${event.recordId}:${event.owner}`) return reject('Invalid completion identity');\n if(row?.id!==event.recordId) return reject('Airtable record does not match the completion');\n if(text(field('fld4kyzDwnHq5V4Iy'))!==event.owner) return reject('The list has moved to another run or stage');\n if(field('fldf9wpMGWg0SebHV')!=='Completed') return reject('The list is not in its final Completed state');\n const finished=Date.parse(field('fldMSv3547BOvfdmH')), receiptAt=Date.parse(event.completedAt);\n if(!Number.isFinite(finished)||!Number.isFinite(receiptAt)||finished<receiptAt-1000) return reject('The final completion timestamp is not saved');\n let timing=null;try{timing=JSON.parse(field('fld1QphpklpYJqP0I')??'null');}catch{}\n const name=text(field('fldbg5PAnKyFHc3uy')).trim();\n if(!name) return reject('Missing lead-list name');\n let detail='',heading='';\n if(event.kind==='company'){\n  if(timing?.kind!=='company-expansion'||text(timing.runId)!==event.owner||(timing.recordId&&timing.recordId!==event.recordId)) return reject('This completion is not the final company expansion');\n  const count=num(field('fldRLtvugIxH9qun1')), expected=num(event.companyCount),target=num(field('fldYzvqGmQZxXL9AP'));\n  if(!Number.isInteger(count)||count<0||!Number.isInteger(expected)||count!==expected) return reject('Saved company count does not match the final completion');\n  heading='Company expansion finished';detail=`${count.toLocaleString('en-US')} saved companies.`;\n  if(Number.isFinite(target)&&target>count) detail+=` Below the ${target.toLocaleString('en-US')} target; review the saved results before continuing.`;\n }else if(event.kind==='contact'){\n  if(field('fldiRqsZug1W0Otvs')!=='Completed') return reject('The contact queue has not finished');\n  if(Math.abs(finished-receiptAt)>1000) return reject('The saved contact completion belongs to a later stage');\n  const ids=['fldE2XBsGSES6fT6X','fldkWL67N8ZaBIaDi','fld1pgvOtgJL80iaK'];\n  for(const id of ids){const a=num(field(id)),b=num(event.expectedFields?.[id]);if(!Number.isInteger(a)||a<0||a!==b) return reject('Saved contact counts do not match the verified completion');}\n  heading='Contact expansion finished';detail=`${num(field(ids[0])).toLocaleString('en-US')} contacts reviewed · ${num(field(ids[1])).toLocaleString('en-US')} retained · ${num(field(ids[2])).toLocaleString('en-US')} eligible for verification.`;\n  detail+=' Review the results in Contact Review; these are not yet verified leads.';\n }else return reject('Unsupported completion type');\n const durationStart=Date.parse(timing?.totalStartedAt??field('fldUZOY2Ubs58DQ3V'));\n if(Number.isFinite(durationStart)&&finished>=durationStart){const minutes=Math.round((finished-durationStart)/60000);detail+=`\\nRuntime: ${minutes<60?minutes+' min':Math.floor(minutes/60)+'h '+minutes%60+'m'}.`;}\n const link='https://airtable.com/appxqINt5XKw7a76A/pag1PZd6cHL42uBwg';\n const payload={channel:'C08FDE9K18E',text:`${heading} for ${escape(name).slice(0,1400)}.\\n\\n<${link}|Open lead list>\\n\\n<!channel>`,unfurl_links:false,unfurl_media:false};\n return {ready:true,dryRun,event,payload,kind:event.kind,recordId:event.recordId};\n}\nif(typeof module!=='undefined')module.exports={prepareExpansionAlert};\n\nconst source=$('Unpack completion').item.json;return {json:prepareExpansionAlert(source.event,$json.records?.[0],source.dryRun)};"
   }
  },
