  {
   "parameters": {
    "mode": "runOnceForEachItem",
    "jsCode": "const result=$('Expand Linked Email Accounts').item.json;const reasons=($json['Health Reason']||[]).map(x=>x?.name||x).filter(Boolean);const set=new Set(reasons);if(result.listed)set.add('Blacklist');else set.delete('Blacklist');const remaining=[...set];const current=String($json.Status?.name||$json.Status||'Healthy');let status=current;if(result.listed)status='At Risk';else if(current==='At Risk'&&remaining.length===0)status='Healthy';return {json:{id:$json.id,Status:status,'Health Reason':remaining}};"
