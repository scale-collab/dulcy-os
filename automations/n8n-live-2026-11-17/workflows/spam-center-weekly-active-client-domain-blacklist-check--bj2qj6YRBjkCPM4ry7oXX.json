  {
   "parameters": {
    "mode": "runOnceForEachItem",
    "jsCode": "const source=$('Keep Monitorable Domains').item.json;const start=$('Start Blacklist Check').item.json;const payload=$json.data!==undefined?$json.data:$json;const data=Array.isArray(payload)?(payload[0]||{}):payload;const lists=[data.blacklists,data.results,data.listings,data.blacklist_results,data.rbls].filter(Array.isArray).flat();const listedEntries=lists.filter(e=>{if(typeof e==='string')return true;const s=String(e.status||e.result||'').toLowerCase();return e.listed===true||e.is_listed===true||['listed','blacklisted','fail','failed'].includes(s)});const names=[...new Set(listedEntries.map(e=>typeof e==='string'?e:(e.name||e.blacklist||e.rbl||e.provider||e.host)).filter(Boolean))];const declared=Number(data.blacklists_count??data.blacklist_count??data.listed_count??data.total_listed);const count=Number.isFinite(declared)?declared:names.length;const statusText=String(data.status||data.result||'').toLowerCase();const pending=['pending','queued','processing','running'].includes(statusText);const failed=Boolean($json.error)||Boolean(data.error);const listed=!failed&&!pending&&(data.listed===true||data.is_listed===true||count>0||['listed','blacklisted'].includes(statusText));const checkId=start.data?.uuid||start.data?.id||start.uuid||start.id||'';const previous=source.domainRecord;const domainId=$('Ensure Domain Is In EmailGuard').item.json.data?.uuid||$('Ensure Domain Is In EmailGuard').item.json.data?.id||previous['EmailGuard Domain ID']||'';return {json:{id:source.domainRecordId,'EmailGuard Domain ID':domainId||null,'Monitoring Status':failed?'Error':'Active','Blacklist Status':failed?'Check Failed':pending?'Unknown':listed?'Listed':'Clean','Blacklist Count':failed||pending?Number(previous['Blacklist Count']||0):count,'Blacklists Found':failed||pending?String(previous['Blacklists Found']||''):names.join('\\n'),'Last Blacklist Check':new Date().toISOString(),'Last Blacklist Check ID':checkId||null,'Domain Health':failed?'At Risk':pending?String(previous['Domain Health']?.name||previous['Domain Health']||'Healthy'):listed?'Blacklisted':'Healthy',listed:failed||pending?null:listed,emailAccountLinks:source.emailAccountLinks,domain:source.domain}};"
   },
