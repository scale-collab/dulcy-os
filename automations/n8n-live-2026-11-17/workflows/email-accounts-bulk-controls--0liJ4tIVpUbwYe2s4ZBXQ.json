  {
   "parameters": {
    "jsCode": "const req=$('Resolve Account Records').first().json;const rows=$input.all().map(i=>i.json);const links=v=>(Array.isArray(v)?v:[]).map(x=>x?.id||x).filter(Boolean);const mapped=rows.map(r=>({recordId:r.id,emailId:Number(r['Email ID']),email:r['Email Account'],clientIds:links(r.Client)}));const mismatched=mapped.filter(a=>!a.clientIds.includes(req.clientRecordId));const accounts=mapped.filter(a=>Number.isInteger(a.emailId)&&a.emailId>0);const missing=rows.length-accounts.length;let endpoint='',body={sender_email_ids:accounts.map(a=>a.emailId)};if(req.action==='Turn Warmup On')endpoint='/api/warmup/sender-emails/enable';if(req.action==='Turn Warmup Off')endpoint='/api/warmup/sender-emails/disable';if(req.action==='Update Warmup Limit'){endpoint='/api/warmup/sender-emails/update-daily-warmup-limits';body.daily_limit=req.warmupLimit;}if(req.action==='Update Daily Limit'){endpoint='/api/sender-emails/daily-limits/bulk';body.daily_limit=req.dailyLimit;}const errors=[];if(!accounts.length)errors.push('No matched account has a valid Email ID');if(missing)errors.push(`${missing} matched account(s) are missing Email ID`);if(mismatched.length)errors.push(`Safety check blocked ${mismatched.length} account(s) that do not belong to the selected client: ${mismatched.map(a=>a.email).join(', ')}`);return [{json:{...req,accounts,matchedCount:rows.length,endpoint,body,ready:errors.length===0,error:errors.join('; ')}}];"
