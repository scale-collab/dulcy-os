  {
   "parameters": {
    "jsCode": "const grouped = {};\n\nfor (const item of items) {\n  const f = item.json;\n\n  const clientId =\n    Array.isArray(f.Client) && f.Client.length\n      ? f.Client[0]\n      : 'UNKNOWN_CLIENT';\n\n  grouped[clientId] = (grouped[clientId] || 0) + 1;\n}\n\nreturn Object.entries(grouped).map(([clientId, count]) => ({\n  json: { clientId, count }\n}));"
