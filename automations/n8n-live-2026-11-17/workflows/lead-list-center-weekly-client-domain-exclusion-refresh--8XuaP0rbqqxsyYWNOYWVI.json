  {
   "parameters": {
    "jsCode": "const parse=value=>{if(typeof value!=='string')return value;try{return JSON.parse(value);}catch{return value;}};const responses=$input.all().map(item=>parse(item.json?.body??item.json));const records=responses.flatMap(value=>Array.isArray(value?.records)?value.records:(value?.fields?[value]:[]));const statusFields=['Status','Client Status','Workspace Status'];const nameFields=['Client Name','Name','Client','Company Name','Workspace Name'];const allowed=new Set(['active','onboarding']);const clients=[];for(const record of records){const fields=record?.fields??{};let status='';for(const key of statusFields){const raw=fields[key];const value=Array.isArray(raw)?raw[0]:raw;if(value!==undefined&&value!==null&&String(value).trim()){status=String(value).trim();break;}}if(!status||!allowed.has(status.toLowerCase()))continue;let clientName='';for(const key of nameFields){const raw=fields[key];const value=Array.isArray(raw)?raw[0]:raw;if(value!==undefined&&value!==null&&String(value).trim()){clientName=String(value).trim();break;}}if(!/^rec[A-Za-z0-9]+$/.test(String(record?.id??'')))continue;clients.push({json:{recordId:record.id,clientName,status}});}if(!clients.length)throw new Error('No active or onboarding Workspace IDs records were found. Confirm the client status field name and values.');return clients;"
   },
