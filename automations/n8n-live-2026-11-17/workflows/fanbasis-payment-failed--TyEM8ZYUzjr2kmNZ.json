  {
   "parameters": {
    "jsCode": "// Only confirmed Fanbasis customer details may reach client-specific writes.\nconst response = $('check payment method1').first().json;\nconst body = response.body ?? response;\nconst status = Number(response.statusCode || (body.status === 'success' ? 200 : 0));\nif (status === 404 && body.message === 'Customer not found') return [];\nif (status < 200 || status >= 300 || body.status !== 'success') {\n  throw new Error('Fanbasis customer lookup failed: HTTP ' + status);\n}\nconst email = String(body.data?.customer?.email || '').trim().toLowerCase();\nif (!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email)) return [];\nconst domain = email.split('@')[1];\nconst genericDomains = ['gmail.com','yahoo.com','outlook.com','hotmail.com','icloud.com','aol.com','proton.me','me.com'];\nreturn [{json:{lookup_key:genericDomains.includes(domain) ? email : domain,message_timestamp:Date.now()}}];\n"
   },
