  {
   "parameters": {
    "method": "POST",
    "url": "https://slack.com/api/chat.postMessage",
    "authentication": "predefinedCredentialType",
    "nodeCredentialType": "slackApi",
    "sendBody": true,
    "contentType": "raw",
    "rawContentType": "application/json",
    "body": "={{ JSON.stringify({ channel: 'C075UR0HRRR', text: (() => { const e = $('Normalize SignWell Event').item.json; const a = ($('Find Sent Airtable Agreement').item.json.records || [])[0]?.fields || {}; const company = a['Company Name'] || e.recipients?.[0]?.email || 'A client'; const type = a['Agreement Type']?.name || a['Agreement Type'] || 'agreement'; return e.eventType === 'document_viewed' ? company + ' viewed the ' + type + ' agreement on ' + $now.toFormat('MM-dd-yyyy') + '.' : company + ' was sent the ' + type + ' agreement on ' + $now.toFormat('MM-dd-yyyy') + '.'; })() }) }}",
    "options": {}
   },
   "id": "9971fd63-dba6-401c-aaff-ce0010657e27",
   "name": "Notify Slack - Sent or Viewed",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "position": [
    5472,
    1040
   ]
  },
  {
   "parameters": {
    "jsCode": "const event = $('Normalize SignWell Event').item.json;\nconst agreement = ($json.records || [])[0];\nif (!agreement) return [];\nreturn [{ json: {\n  airtableRecordId: agreement.id,\n  eventType: event.eventType,\n  eventAt: event.completedAt,\n  documentId: event.documentId,\n  contractUrl: `https://www.signwell.com/app/documents/${event.documentId}`\n} }];"
   },
   "id": "4eab762a-fc4e-4b4b-a580-f8aae4a9b767",
   "name": "Prepare Sent or Viewed Event",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    5248,
    1232
   ]
  },
  {
   "parameters": {
    "jsCode": "const item = $json;\nif (item.eventType !== 'document_sent') return [];\nconst agreement = ($('Find Sent Airtable Agreement').item.json.records || [])[0];\nconst fields = agreement?.fields || {};\nconst leadId = String(fields['Reference Number'] || '').trim();\nif (!leadId.startsWith('lead_')) return [];\nreturn [{ json: { ...item, leadId } }];"
   },
