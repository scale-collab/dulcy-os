   "id": "bc60a737-5529-481c-b32f-ea9f3def9719",
   "name": "SignWell Events",
   "type": "n8n-nodes-base.webhook",
   "typeVersion": 2,
   "position": [
    4128,
    1040
   ]
  },
  {
   "parameters": {
    "jsCode": "const payload = $json.body || $json;\nconst eventType = String(payload.event?.type || '');\nconst document = payload.data?.object || {};\nconst documentId = String(document.id || '');\nif (!eventType || !documentId) throw new Error('Invalid SignWell webhook: event type or document ID is missing');\nconst rawTime = payload.event?.time;\nconst completedAt = rawTime\n  ? new Date(Number(rawTime) * 1000).toISOString()\n  : new Date().toISOString();\nreturn [{ json: {\n  eventType,\n  eventHash: String(payload.event?.hash || ''),\n  documentId,\n  completedAt,\n  documentName: String(document.name || `SignWell Agreement ${documentId}`),\n  metadata: document.metadata || {},\n  recipients: document.recipients || [],\n  payload\n} }];"
   },
