  {
   "parameters": {
    "jsCode": "const prep = $('Prepare Completion').item.json;\nconst pdfUrl = String($json.url || $json.download_url || $json.file_url || '');\nif (!pdfUrl) throw new Error('SignWell completed PDF endpoint did not return a URL');\nconst safeName = prep.documentName.replace(/[^a-z0-9._-]+/gi, '-').replace(/^-+|-+$/g, '');\nreturn [{ json: { ...prep, pdfUrl, filename: `${safeName || prep.documentId}-signed.pdf` } }];"
   },
