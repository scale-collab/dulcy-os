   "id": "cd246233-4b2e-4504-914b-d79029168ee5",
   "name": "Find Sent Airtable Agreement",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "position": [
    5024,
    1232
   ]
  },
  {
   "parameters": {
    "jsCode": "const event = $('Normalize SignWell Event').item.json;\nconst agreement = ($json.records || [])[0];\nif (!agreement) return [];\nconst f = agreement.fields || {};\nconst leadId = String(f['Reference Number'] || f['Reference ID'] || '').trim();\nif (!leadId) throw new Error('Reference Number is missing from the Airtable agreement');\nconst additional = ['Cold Email'];\nif (f['LinkedIn']) additional.push('LinkedIn');\nif (f['AI / Cold Caller']) additional.push('AI Caller / Call Flow');\nif (f['Direct Mail']) additional.push('Direct Mail');\nreturn [{ json: {\n  airtableRecordId: agreement.id,\n  existingFields: f,\n  alreadyForwarded: Boolean(f['SignWell Completion Forwarded At']),\n  documentId: event.documentId,\n  documentName: event.documentName,\n  completedAt: event.completedAt,\n  eventHash: event.eventHash,\n  recipients: event.recipients,\n  leadId,\n  company: String(f['Company Name'] || '').trim(),\n  name: [f['First Name'], f['Last Name']].filter(Boolean).join(' ').trim(),\n  additional: additional.join(', '),\n  payload: event.payload\n} }];"
   },
   "id": "b1243884-3716-43e3-8429-217e72a98170",
   "name": "Prepare Completion",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    5024,
    848
   ]
  },
  {
   "parameters": {
    "method": "PATCH",
    "url": "=https://api.airtable.com/v0/appxqINt5XKw7a76A/tbljivFOoUW2nZ6FN/{{$json.airtableRecordId}}",
    "authentication": "genericCredentialType",
    "genericAuthType": "httpHeaderAuth",
    "sendBody": true,
    "contentType": "raw",
    "rawContentType": "application/json",
    "body": "={{ JSON.stringify({ fields: $json.eventType === 'document_viewed' ? { 'Agreement Status': 'Viewed', 'SignWell Viewed At': $json.eventAt, 'SignWell Last Event': 'document_viewed', 'Last SignWell Sync': $now.toISO(), 'SignWell Error': '' } : { 'Agreement Status': 'Sent', 'SignWell Sent At': $json.eventAt, 'SignWell Last Event': 'document_sent', 'Last SignWell Sync': $now.toISO(), 'SignWell Error': '' } }) }}",
    "options": {}
   },
   "id": "f5b19f8d-4f99-4549-a3c7-0a2dcdf8b2b9",
