    "jsCode": "const test = $('Get Test Results').first().json.data;\n\nconst emails = test.inbox_placement_test_emails || [];\n\nconst stats = {\n  Google: {\n    total: 0,\n    inbox: 0,\n  },\n  Microsoft: {\n    total: 0,\n    inbox: 0,\n  },\n};\n\nfor (const email of emails) {\n  const provider = email.provider;\n\n  if (!stats[provider]) continue;\n\n  stats[provider].total++;\n\n  if ((email.folder || '').toLowerCase() === 'inbox') {\n    stats[provider].inbox++;\n  }\n}\n\nconst googlePercentage =\n  stats.Google.total > 0\n    ? Math.round((stats.Google.inbox / stats.Google.total) * 100)\n    : 0;\n\nconst outlookPercentage =\n  stats.Microsoft.total > 0\n    ? Math.round((stats.Microsoft.inbox / stats.Microsoft.total) * 100)\n    : 0;\n\nreturn [\n  {\n    json: {\n      google_percentage: googlePercentage,\n      outlook_percentage: outlookPercentage,\n\n      google_inbox: stats.Google.inbox,\n      google_total: stats.Google.total,\n\n      outlook_inbox: stats.Microsoft.inbox,\n      outlook_total: stats.Microsoft.total,\n\n      completed:\n        emails.every(\n          e =>\n            e.status === 'email_received' ||\n            e.status === 'email_not_received'\n        ),\n    },\n  },\n];"
   },
