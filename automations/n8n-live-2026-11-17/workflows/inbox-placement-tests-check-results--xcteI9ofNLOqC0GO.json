   "name": "Get Email Account Health"
  },
  {
   "parameters": {
    "jsCode": "const row = $json;\nconst score = Number($('Get Test Results').item.json.data.overall_score || 0);\nconst rawReasons = row['Health Reason'];\nconst reasons = (Array.isArray(rawReasons) ? rawReasons : rawReasons ? [rawReasons] : [])\n  .map((reason) => reason?.name || reason)\n  .filter(Boolean)\n  .filter((reason) => reason !== 'Poor Inbox Placement');\n\nif (score <= 60) reasons.push('Poor Inbox Placement');\n\nconst proposedReasons = [...new Set(reasons)];\nlet proposedStatus;\nif (score <= 60 || proposedReasons.includes('Blacklist')) {\n  proposedStatus = 'Spam';\n} else if (proposedReasons.length > 0) {\n  proposedStatus = 'At Risk';\n} else {\n  proposedStatus = 'Healthy';\n}\n\nreturn [{ json: { ...row, proposed_health_reasons: proposedReasons, proposed_status: proposedStatus } }];"
   },
