  {
   "parameters": {
    "jsCode": "// Editable thresholds\nconst LOW_WARMUP_SCORE = 95;\nconst HIGH_BOUNCE_RATE = 3;\nconst LOW_REPLY_RATE = 1;\nconst MIN_SENT_FOR_BOUNCE = 100;\nconst MIN_CONTACTED_FOR_REPLY = 200;\n\nreturn items.map((item) => {\n  const row = item.json;\n  const sent = Number(row.emails_sent_count || 0);\n  const contacted = Number(row.total_leads_contacted_count || 0);\n  const bounced = Number(row.bounced_count || 0);\n  const replies = Number(row.unique_replied_count || 0);\n  const warmupScore = Number(row.warmup_score || 0);\n\n  const bounceRate = sent > 0\n    ? Number(((bounced / sent) * 100).toFixed(2))\n    : null;\n  const replyRate = contacted > 0\n    ? Number(((replies / contacted) * 100).toFixed(2))\n    : null;\n\n  const currentStatus = row.Status?.name || row.Status || null;\n  const currentReason = row['Health Reason']?.name || row['Health Reason'] || null;\n\n  // These reasons are owned by other health automations and must not be overwritten here.\n  const externallyOwnedReasons = [\n    'Poor Inbox Placement',\n    'Blacklist',\n    'Manual Review'\n  ];\n\n  let proposedStatus = 'Healthy';\n  let proposedReason = null;\n  let decision = 'Healthy: monitored metrics are within thresholds';\n  let shouldUpdate = false;\n\n  if (currentStatus === 'At Risk' && externallyOwnedReasons.includes(currentReason)) {\n    proposedStatus = currentStatus;\n    proposedReason = currentReason;\n    decision = `Preserved external health reason: ${currentReason}`;\n  } else if (row.warmup_enabled !== true) {\n    proposedStatus = 'At Risk';\n    proposedReason = 'Low Warmup Score';\n    decision = 'Warmup is disabled';\n  } else if (warmupScore > 0 && warmupScore < LOW_WARMUP_SCORE) {\n    proposedStatus = 'At Risk';\n    proposedReason = 'Low Warmup Score';\n    decision = `Warmup score ${warmupScore} is below ${LOW_WARMUP_SCORE}`;\n  } else if (sent >= MIN_SENT_FOR_BOUNCE && bounceRate >= HIGH_BOUNCE_RATE) {\n    proposedStatus = 'At Risk';\n    proposedReason = 'High Bounce Rate';\n    decision = `Bounce rate ${bounceRate}% is at or above ${HIGH_BOUNCE_RATE}%`;\n  } else if (contacted >= MIN_CONTACTED_FOR_REPLY && replyRate < LOW_REPLY_RATE) {\n    proposedStatus = 'At Risk';\n    proposedReason = 'Low Reply Rate';\n    decision = `Reply rate ${replyRate}% is below ${LOW_REPLY_RATE}%`;\n  }\n\n  if (!(currentStatus === 'At Risk' && externallyOwnedReasons.includes(currentReason))) {\n    shouldUpdate = currentStatus !== proposedStatus || currentReason !== proposedReason;\n  }\n\n  return {\n    json: {\n      ...row,\n      bounce_rate: bounceRate,\n      reply_rate: replyRate,\n      proposed_status: proposedStatus,\n      proposed_health_reason: proposedReason,\n      health_decision: decision,\n      should_update: shouldUpdate\n    }\n  };\n});"
   },
   "id": "00455089-93a7-463c-9b4c-4b20e6718836",
   "name": "Calculate and Classify Health",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    -1744,
    128
   ]
  },
  {
   "parameters": {
    "jsCode": "// Rebuild Health Reason as a multiple-select array.\n// This node preserves reasons owned by other automations and recalculates only math-owned reasons.\nconst LOW_WARMUP_SCORE = 95;\nconst HIGH_BOUNCE_RATE = 3;\nconst LOW_REPLY_RATE = 1;\nconst MIN_SENT_FOR_BOUNCE = 100;\nconst MIN_CONTACTED_FOR_REPLY = 200;\n\nconst EXTERNAL_REASONS = [\n  'Poor Inbox Placement',\n  'Blacklist',\n  'Manual Review'\n];\n\nreturn items.map((item) => {\n  const row = item.json;\n  const rawReasons = row['Health Reason'];\n  const currentReasons = (Array.isArray(rawReasons) ? rawReasons : rawReasons ? [rawReasons] : [])\n    .map((reason) => reason?.name || reason)\n    .filter(Boolean);\n\n  const externalReasons = currentReasons.filter((reason) => EXTERNAL_REASONS.includes(reason));\n  const metricReasons = [];\n\n  const sent = Number(row.emails_sent_count || 0);\n  const contacted = Number(row.total_leads_contacted_count || 0);\n  const bounced = Number(row.bounced_count || 0);\n  const replies = Number(row.unique_replied_count || 0);\n  const warmupScore = Number(row.warmup_score || 0);\n  const bounceRate = sent > 0 ? Number(((bounced / sent) * 100).toFixed(2)) : null;\n  const replyRate = contacted > 0 ? Number(((replies / contacted) * 100).toFixed(2)) : null;\n\n  if (row.warmup_enabled !== true || (warmupScore > 0 && warmupScore < LOW_WARMUP_SCORE)) {\n    metricReasons.push('Low Warmup Score');\n  }\n  if (sent >= MIN_SENT_FOR_BOUNCE && bounceRate >= HIGH_BOUNCE_RATE) {\n    metricReasons.push('High Bounce Rate');\n  }\n  if (contacted >= MIN_CONTACTED_FOR_REPLY && replyRate < LOW_REPLY_RATE) {\n    metricReasons.push('Low Reply Rate');\n  }\n\n  const proposedReasons = [...new Set([...externalReasons, ...metricReasons])];\n  const currentStatus = row.Status?.name || row.Status || null;\n  const proposedStatus = externalReasons.length > 0\n    ? (currentStatus || 'At Risk')\n    : proposedReasons.length > 0\n      ? 'At Risk'\n      : 'Healthy';\n\n  const normalizedCurrent = [...new Set(currentReasons)].sort();\n  const normalizedProposed = [...proposedReasons].sort();\n  const reasonsChanged = JSON.stringify(normalizedCurrent) !== JSON.stringify(normalizedProposed);\n  const statusChanged = currentStatus !== proposedStatus;\n\n  return {\n    json: {\n      ...row,\n      bounce_rate: bounceRate,\n      reply_rate: replyRate,\n      proposed_status: proposedStatus,\n      proposed_health_reasons: proposedReasons,\n      health_decision: proposedReasons.length > 0\n        ? `Active reasons: ${proposedReasons.join(', ')}`\n        : 'Healthy: monitored metrics are within thresholds',\n      should_update: reasonsChanged || statusChanged\n    }\n  };\n});"
   },
