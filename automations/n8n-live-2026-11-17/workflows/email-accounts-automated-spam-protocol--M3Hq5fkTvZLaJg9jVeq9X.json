  {
   "parameters": {
    "jsCode": "const test = $('Find Unprocessed Tests').first().json;\nconst a = $('Find Email Account').first().json;\nconst ws = $('Get Workspace').first().json;\n\nif (!a.id) throw new Error('No Email Account matched Email ID ' + test['Email ID']);\nif (!ws['EmailBison API']) throw new Error('Workspace is missing EmailBison API');\n\nconst score = Number(test['Overall Score']);\nconst stage = a['Spam Protocol Stage'] || 'Monitoring';\nconst due = a['Spam Retest Due'] ? new Date(a['Spam Retest Due']) : null;\nconst testDate = new Date(test['Test Date'] || test.createdTime || Date.now());\nconst poor = score <= 60;\nconst dueNow = due && testDate >= due;\nconst duplicate = String(a['Last Spam Protocol Test ID'] || '') === String(test['Test ID'] || '');\n\nlet action = 'no_action';\nlet outcome = 'No Action';\nlet newLimit = Number(a.email_daily_limit || 15);\nlet failed = Number(a['Spam Failed Tests'] || 0);\n\nif (!duplicate && poor && stage !== 'Resting 7 Days' && !String(stage).startsWith('Replace')) {\n  action = 'rest';\n  outcome = 'Rest Started';\n  newLimit = 1;\n  failed += 1;\n} else if (!duplicate && !poor && stage === 'Resting 7 Days' && dueNow) {\n  action = 'recover';\n  outcome = 'Recovered';\n  newLimit = Number(a['Previous Daily Limit'] || 15);\n} else if (!duplicate && poor && stage === 'Resting 7 Days' && dueNow) {\n  action = 'replace_domain';\n  outcome = 'Replace Domain';\n  newLimit = 1;\n  failed += 1;\n} else if (!duplicate && poor && stage === 'Resting 7 Days') {\n  action = 'hold';\n  newLimit = 1;\n}\n\nconst now = new Date();\nconst retest = new Date(now.getTime() + 7 * 86400000);\n\nconst reasons = Array.isArray(a['Health Reason'])\n  ? a['Health Reason'].map(x => x.name || x)\n  : [];\n\nconst nextReasons = poor\n  ? [...new Set([...reasons, 'Poor Inbox Placement'])]\n  : reasons.filter(x => x !== 'Poor Inbox Placement');\n\nreturn [{\n  json: {\n    action,\n    outcome,\n    score,\n    poor,\n    newLimit,\n    failed,\n    accountRecordId: a.id,\n    testRecordId: test.id,\n    testId: String(test['Test ID'] || ''),\n    emailId: Number(a['Email ID']),\n    apiKey: ws['EmailBison API'],\n    previousLimit: Number(a['Previous Daily Limit'] || a.email_daily_limit || 15),\n    restStarted: action === 'rest' ? now.toISOString() : (a['Spam Rest Started'] || null),\n    retestDue: action === 'rest' ? retest.toISOString() : (a['Spam Retest Due'] || null),\n    nextReasons,\n    clientLinks: a.Client || [],\n    domainLinks: a.Domains || [],\n    email: a['Email Account'],\n    stage:\n      action === 'rest' ? 'Resting 7 Days' :\n      action === 'recover' ? 'Recovered' :\n      action === 'replace_domain' ? 'Replace Domain' :\n      stage,\n    accountStatus: poor ? 'Resting' : (nextReasons.length ? 'At Risk' : 'Healthy'),\n    needsApi: ['rest', 'recover', 'hold', 'replace_domain'].includes(action),\n    needsQueue: action === 'replace_domain'\n  }\n}];"
   },
