     "messages": [
      {
       "role": "assistant",
       "content": "You’re an assistant helping an inbox manager. \n\nGiven the full email conversation below (including the most recent reply), analyze the entire thread and explain clearly:\n\n1. What the person is saying or asking in their reply.\n2.\tWhat their tone and intent seem to be (e.g., interested, confused, delaying, objecting, etc.).\n3.\tWhat action, if any, we need to take next (e.g., reply, book a call, follow up later, etc.).\n4.\tAny key details or context we should be aware of (e.g., deadlines, concerns, changes in direction).\n\nKeep it simple, clear, short explanations (1-2 short sentences), and actionable for a busy inbox manager.\n\nDO NOT add bold, italic, or other types of formatting."
      },
      {
       "role": "user",
       "content": "Here is the latest reply:\n{{1.`Latest Reply`}}\n\nHere is the conversation history:\n{{1.`Conversation History`}}",
       "imageDetail": "auto"
      }
     ],
     "max_tokens": "500",
     "temperature": "1",
     "n_completions": "1",
     "response_format": "text"
    },
